# 复制为 .env 后按本机路径填写；.env 只用于本地开发，不随插件分发。

# Zotero 可执行文件（下面为 macOS 默认路径；Windows / Linux 换成实际路径）
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero

# 开发用 profile 目录（通过 `zotero -p` 创建；不同机器目录名不同）
# macOS: /Users/<name>/Library/Application Support/Zotero/Profiles/<id>.default
ZOTERO_PLUGIN_PROFILE_PATH="/Users/<name>/Library/Application Support/Zotero/Profiles/<profile-id>.default"

# Zotero 数据目录（留空则使用默认目录）
ZOTERO_PLUGIN_DATA_DIR="/Users/<name>/Zotero"
